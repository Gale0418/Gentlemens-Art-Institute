{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "紳士藝術研究所 Gentlemen's Art Institute",
  "version": "1.0.0",
  "identifier": "com.windsheep.gai",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "紳士藝術研究所 Gentlemen's Art Institute",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' gai:; img-src 'self' gai: data: blob:; object-src 'none'; base-uri 'self';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "macOS": {
      "bundleVersion": "36",
      "signingIdentity": "-"
    },
    "iOS": {
      "minimumSystemVersion": "15.0",
      "bundleVersion": "37"
    }
  }
}
